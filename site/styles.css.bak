:root {
  --black: #000000;
  --white: #ffffff;
  --blood: #880808;
  --gray-50: #fafafa;
  --gray-100: #f0f0f0;
  --gray-200: #e5e5e5;
}

@import url('https://fonts.cdnfonts.com/css/gotham');

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Helvetica Neue", "Helvetica Neue Light", Arial, sans-serif;
  font-weight: 300;
  background: var(--white);
  color: var(--black);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* Navigation */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

.nav-inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 1rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-brand {
  font-size: 0.875rem;
  letter-spacing: 0.3em;
  font-weight: 300;
  color: var(--black);
}

.nav-links {
  display: flex;
  gap: 2rem;
}

.nav-link {
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-decoration: none;
  color: rgba(0, 0, 0, 0.5);
  transition: color 0.3s ease;
}

.nav-link:hover,
.nav-link.active {
  color: var(--blood);
}

/* Hero Section */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 1.5rem;
  overflow: hidden;
  background: var(--white);
}

.hero-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 0;
  transition: opacity 0.1s ease-out;
}

.hero-content {
  position: relative;
  z-index: 10;
  max-width: 1000px;
  text-align: center;
}

.hero-subtitle {
  font-size: 0.75rem;
  letter-spacing: 0.3em;
  color: rgba(0, 0, 0, 0.4);
  margin-bottom: 2rem;
  transition: transform 0.1s ease-out, opacity 0.1s ease-out;
}

.hero-title {
  font-family: 'Gotham Black', sans-serif;
  font-size: clamp(2.5rem, 8vw, 4.5rem);
  font-weight: 900;
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin-bottom: 2rem;
  color: var(--black);
  transition: transform 0.1s ease-out, opacity 0.1s ease-out;
}

.accent {
  color: var(--blood);
}

.hero-desc {
  font-size: clamp(0.9rem, 2vw, 1rem);
  color: rgba(0, 0, 0, 0.5);
  line-height: 1.8;
  max-width: 42rem;
  margin: 0 auto;
  letter-spacing: 0.05em;
  transition: transform 0.1s ease-out, opacity 0.1s ease-out;
}

/* Scroll Indicator */
.scroll-indicator {
  position: absolute;
  bottom: 2.5rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  animation: scrollPulse 2s ease-in-out infinite;
}

.scroll-chevron {
  width: 12px;
  height: 12px;
  border-right: 1px solid rgba(0, 0, 0, 0.5);
  border-bottom: 1px solid rgba(0, 0, 0, 0.5);
  transform: rotate(45deg);
}

@keyframes scrollPulse {
  0%, 100% {
    opacity: 0.3;
    transform: translateX(-50%) translateY(0);
  }
  50% {
    opacity: 0.8;
    transform: translateX(-50%) translateY(8px);
  }
}

/* Container */
.container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.container-narrow {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* Section Label */
.section-label {
  font-family: 'Gotham Black', sans-serif;
  font-size: 0.75rem;
  font-weight: 900;
  letter-spacing: 0.3em;
  color: rgba(0, 0, 0, 0.35);
  margin-bottom: 4rem;
  text-align: left;
}

/* Work Section */
.work {
  padding: 4rem 0 8rem;
  background: var(--gray-50);
  position: relative;
  z-index: 10;
}

.case-studies {
  display: flex;
  flex-direction: column;
  gap: 4rem;
}

/* Case Study Card */
.case-study-card {
  background: var(--white);
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 0;
  transition: border-color 0.3s ease;
}

.case-study-card:hover {
  border-color: rgba(0, 0, 0, 0.2);
}

.case-study-hero-image {
  width: 100%;
  padding-bottom: 56.25%;
  background: var(--gray-100);
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.case-study-hero-image img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.case-study-hero-image span {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: rgba(0, 0, 0, 0.2);
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.case-study-content {
  padding: 2.5rem;
}

.case-study-title {
  font-family: 'Gotham Black', sans-serif;
  font-size: clamp(1.1rem, 2.5vw, 1.4rem);
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--black);
  margin-bottom: 0.75rem;
}

.case-study-tags {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: rgba(0, 0, 0, 0.4);
  margin-bottom: 1.5rem;
}

.case-study-desc {
  color: rgba(0, 0, 0, 0.6);
  line-height: 1.7;
  max-width: 720px;
  margin-bottom: 1.5rem;
  font-size: 0.95rem;
}

/* Process Strip */
.process-strip {
  display: flex;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
  overflow-x: auto;
}

.process-thumb {
  flex-shrink: 0;
  text-align: center;
}

.process-thumb-img {
  width: 80px;
  height: 80px;
  background: var(--gray-100);
  border: 1px solid rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0.4rem;
}

.process-thumb-img span {
  color: rgba(0, 0, 0, 0.2);
  font-size: 0.55rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.process-thumb-label {
  font-size: 0.6rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: rgba(0, 0, 0, 0.35);
}

/* Case Study Link */
.case-study-link {
  display: inline-block;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--blood);
  text-decoration: none;
  transition: color 0.2s ease;
}

.case-study-link:hover {
  text-decoration: underline;
  color: var(--blood);
}

/* Buttons */
.btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem 2rem;
  border: 1px solid rgba(0, 0, 0, 0.15);
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  color: var(--black);
  text-decoration: none;
  transition: border-color 0.3s ease, color 0.3s ease;
}

.btn-outline:hover {
  border-color: var(--blood);
  color: var(--blood);
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem 2rem;
  background: var(--blood);
  color: var(--white);
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-decoration: none;
  transition: background 0.3s ease;
}

.btn-primary:hover {
  background: var(--blood);
  opacity: 0.85;
}

/* About Section */
.about {
  padding: 8rem 0;
  background: var(--white);
  position: relative;
  z-index: 10;
}

.about-intro {
  max-width: 640px;
}

.about-title {
  font-size: clamp(1.875rem, 4vw, 2.5rem);
  font-weight: 300;
  letter-spacing: -0.02em;
  line-height: 1.3;
  margin-bottom: 0.5rem;
  color: var(--black);
}

.about-subtitle {
  color: rgba(0, 0, 0, 0.45);
  font-size: 1rem;
  font-weight: 300;
  margin-bottom: 2rem;
}

.about-text {
  font-size: 1rem;
  color: rgba(0, 0, 0, 0.6);
  line-height: 1.7;
  margin-bottom: 2rem;
  max-width: 640px;
}

.about-currently {
  font-size: 0.85rem;
  color: rgba(0, 0, 0, 0.4);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  line-height: 1.7;
}

/* Contact Section */
.contact {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rem 1.5rem;
  background: var(--gray-50);
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 10;
}

.contact-inner {
  max-width: 42rem;
  text-align: center;
}

.contact-title {
  font-size: clamp(1.5rem, 4vw, 2rem);
  font-weight: 300;
  letter-spacing: 0.1em;
  line-height: 1.3;
  margin-bottom: 2.5rem;
  color: var(--black);
}

.contact-actions {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  align-items: center;
}

.contact-social {
  display: flex;
  gap: 2rem;
  flex-wrap: wrap;
  justify-content: center;
}

.contact-social a {
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  color: rgba(0, 0, 0, 0.35);
  text-decoration: none;
  transition: color 0.3s ease;
}

.contact-social a:hover {
  color: var(--blood);
}

/* Footer */
.footer {
  border-top: 1px solid rgba(0, 0, 0, 0.08);
  padding: 2rem 1.5rem;
  background: var(--white);
  position: relative;
  z-index: 10;
}

.footer-inner {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  font-size: 0.75rem;
  color: rgba(0, 0, 0, 0.3);
}

@media (min-width: 768px) {
  .footer-inner {
    flex-direction: row;
    justify-content: space-between;
  }
}

.footer-copy {
  letter-spacing: 0.2em;
}

.footer-motto {
  letter-spacing: 0.02em;
  font-style: italic;
}

/* Responsive: Case Study Cards */
@media (max-width: 768px) {
  .case-study-content {
    padding: 1.5rem;
  }
  .case-study-desc {
    max-width: 100%;
  }
  .process-thumb-img {
    width: 60px;
    height: 60px;
  }
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  * {
    animation: none !important;
    transition: none !important;
  }
}